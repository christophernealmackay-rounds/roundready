# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Database (Supabase pooler — Transaction mode for async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Frontend (Next.js — prefix required for client-side access)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
